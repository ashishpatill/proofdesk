# ProofDesk environment. Copy to .env and fill in. Never commit .env.

# vLLM endpoint on the AMD droplet (OpenAI-compatible).
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=

# Model names as served by vLLM.
DRAFTER_MODEL=Qwen/Qwen2.5-14B-Instruct
CHECKER_MODEL=Qwen/Qwen2.5-32B-Instruct

# Decision layer (d3-lite service beside vLLM).
DECISION_BASE_URL=http://localhost:8002
DECISION_MODEL=vllm-sr/d3-lite

# Evolus workspace API.
EVOLUS_API_BASE=
EVOLUS_API_KEY=
