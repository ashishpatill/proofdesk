# ProofDesk environment. Copy to .env and fill in. Never commit .env.

# --- Model endpoint: AMD Token Factory (default, hackathon) ---
# OpenAI-compatible, free for hackathon teams (daily usage cap).
# Get the team key from https://notebooks.amd.com/tokenfactory
VLLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
VLLM_API_KEY=

# Model names as served by Token Factory.
DRAFTER_MODEL=DeepSeek-V4.1-Flash
CHECKER_MODEL=Qwen3.8-27B

# --- Alternative: self-hosted vLLM on an AMD Developer Cloud droplet ---
# VLLM_BASE_URL=http://localhost:8001/v1
# DRAFTER_MODEL=Qwen/Qwen2.5-14B-Instruct
# CHECKER_MODEL=Qwen/Qwen2.5-32B-Instruct

# Decision layer (d3-lite service beside vLLM; rules fallback if absent).
DECISION_BASE_URL=http://localhost:8002
DECISION_MODEL=vllm-sr/d3-lite

# Evolus workspace API.
EVOLUS_API_BASE=
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=
EVOLUS_WORKFLOW_ID=
